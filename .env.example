# Copy to .env and adjust. Every value here has a working default, so an empty
# .env is fine.
#
#   cp .env.example .env

# --- Data ------------------------------------------------------------------
# Providers tried in order when DEFAULT_PROVIDER=auto. The simulator is
# deliberately absent: simulated bars standing in for a failed download produce
# results that look real and are not. Ask for it explicitly instead.
PROVIDER_CHAIN=csv,ibkr,yfinance,stooq
DEFAULT_PROVIDER=auto
DEFAULT_INTERVAL=1d
DEFAULT_START=2015-01-01
DEFAULT_UNIVERSE=us_sectors
CACHE_TTL_HOURS=12

# --- Backtest --------------------------------------------------------------
INITIAL_CAPITAL=100000
# Charged on every unit of traded notional, in basis points.
COMMISSION_BPS=2.0
SLIPPAGE_BPS=3.0
# Annual rate earned on cash while flat.
CASH_YIELD=0.0
# Annual volatility a volatility-targeted strategy aims at.
TARGET_VOLATILITY=0.15
MAX_LEVERAGE=1.5
RISK_FREE_RATE=0.02

# --- Display ---------------------------------------------------------------
THEME_MODE=light
# classic uses green and red for candles; brand keeps them in the blue palette.
CANDLE_SCHEME=classic

# --- Optional API keys -----------------------------------------------------
# Neither Yahoo Finance nor Stooq needs a key. Add one here if you wire up a
# provider that does, and never commit the .env file.
# API_KEY=your-api-key
